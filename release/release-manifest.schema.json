{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frabcd.github.io/codex-ai-game-studio/schemas/release-manifest.schema.json",
  "title": "Codex AI Game Studio release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "source_repository", "reproducible_zip_timestamp", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_repository": {"const": "https://github.com/frabcd/codex-ai-game-studio"},
    "reproducible_zip_timestamp": {"const": "1980-01-01T00:00:00Z"},
    "artifacts": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "size"],
        "properties": {
          "name": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
